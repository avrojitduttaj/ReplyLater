# ReplyLater Environment Configuration

# Database: SQLite (local dev) or PostgreSQL + pgvector (Docker/production)
DATABASE_URL=sqlite+aiosqlite:///./replylater.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/replylater

# Temporal Server
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=email-triage-queue

# Local Ollama / Gemma
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma2:2b

# Sentry AI Agent Tracing (Optional - local fallback logs traces cleanly if omitted)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
